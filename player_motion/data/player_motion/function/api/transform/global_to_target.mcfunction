# Build the inverse (transpose) of the target's rotation matrix.
data modify storage player_motion: _.transform.sin_pitch set compute default float {type:"minecraft:sin",input:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.target_rotation[1]"},0.017453292519943295]}}
data modify storage player_motion: _.transform.cos_pitch set compute default float {type:"minecraft:cos",input:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.target_rotation[1]"},0.017453292519943295]}}
data modify storage player_motion: _.transform.sin_yaw set compute default float {type:"minecraft:sin",input:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.target_rotation[0]"},0.017453292519943295]}}
data modify storage player_motion: _.transform.cos_yaw set compute default float {type:"minecraft:cos",input:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.target_rotation[0]"},0.017453292519943295]}}

# target.x = global.x*cos(yaw) + global.z*sin(yaw)
data modify storage player_motion: _.target.x set compute default float {type:"minecraft:add",inputs:[{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.calc.x"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.cos_yaw"}]},{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.calc.z"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.sin_yaw"}]}]}
# tmp = -global.x*sin(yaw) + global.z*cos(yaw)
data modify storage player_motion: _.transform.tmp set compute default float {type:"minecraft:sub",left:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.calc.z"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.cos_yaw"}]},right:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.calc.x"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.sin_yaw"}]}}
# target.y = global.y*cos(pitch) + tmp*sin(pitch)
data modify storage player_motion: _.target.y set compute default float {type:"minecraft:add",inputs:[{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.calc.y"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.cos_pitch"}]},{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.tmp"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.sin_pitch"}]}]}
# target.z = tmp*cos(pitch) - global.y*sin(pitch)
data modify storage player_motion: _.target.z set compute default float {type:"minecraft:sub",left:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.tmp"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.cos_pitch"}]},right:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.calc.y"},{type:"minecraft:storage",storage:"player_motion:",path:"_.transform.sin_pitch"}]}}
