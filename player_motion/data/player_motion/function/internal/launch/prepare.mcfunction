# The caller rejects zero vectors before either division by magnitude.
data modify storage player_motion: _.launch.horizontal set compute default float {type:"minecraft:sqrt",input:{type:"minecraft:add",inputs:[{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.x"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.x"}]},{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.z"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.z"}]}]}}
data modify storage player_motion: _.launch.magnitude set compute default float {type:"minecraft:sqrt",input:{type:"minecraft:add",inputs:[{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.horizontal"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.horizontal"}]},{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.y"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.y"}]}]}}
data modify storage player_motion: _.launch.full_count set compute default float {type:"minecraft:floor",input:{type:"minecraft:div",left:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.magnitude"},right:0.8}}
execute store result score #full_count PlayerMotion.X run data get storage player_motion: _.launch.full_count
data modify storage player_motion: _.launch.residual set compute default float {type:"minecraft:min",inputs:[{type:"minecraft:max",inputs:[{type:"minecraft:sub",left:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.magnitude"},right:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.full_count"},0.8]}},0.0]},0.8]}
execute store result score #residual PlayerMotion.X run compute default float {type:"minecraft:ceil",input:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.residual"}}
data modify storage player_motion: _.launch.unit_y set compute default float {type:"minecraft:div",left:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.y"},right:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.magnitude"}}
data modify storage player_motion: _.launch.unit_horizontal set compute default float {type:"minecraft:div",left:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.horizontal"},right:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.magnitude"}}

# Preserve the former pose-based eye-height geometry without lookup tables.
data modify storage player_motion: _.launch.eye_height set value 1.62f
execute anchored eyes positioned ^ ^ ^ if entity @s[distance=..1.27] run data modify storage player_motion: _.launch.eye_height set value 1.27f
execute anchored eyes positioned ^ ^ ^ if entity @s[distance=..0.41] run data modify storage player_motion: _.launch.eye_height set value 0.4f

# full_distance = (1 - 0.8) * 12, strictly positive.
data modify storage player_motion: _.launch.full_distance set compute default float {type:"minecraft:mul",inputs:[{type:"minecraft:sub",left:1.0,right:0.8},12.0]}
data modify storage player_motion: _.launch.full_q set compute default float {type:"minecraft:min",inputs:[{type:"minecraft:max",inputs:[{type:"minecraft:div",left:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.unit_horizontal"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.eye_height"}]},right:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.full_distance"}},-1.0]},1.0]}
data modify storage player_motion: _.launch.full_d set compute default float {type:"minecraft:negate",input:{type:"minecraft:add",inputs:[{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.eye_height"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.unit_y"}]},{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.full_distance"},{type:"minecraft:sqrt",input:{type:"minecraft:max",inputs:[{type:"minecraft:sub",left:1.0,right:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.full_q"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.full_q"}]}},0.0]}}]}]}}

# Skip residual geometry and the residual crystal entirely at exact multiples.
# Residual is clamped to [0, 0.8], so its falloff distance is at least 2.4.
data modify storage player_motion: _.launch.d set value 0.0f
execute if score #residual PlayerMotion.X matches 1 run data modify storage player_motion: _.launch.distance set compute default float {type:"minecraft:mul",inputs:[{type:"minecraft:sub",left:1.0,right:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.residual"}},12.0]}
execute if score #residual PlayerMotion.X matches 1 run data modify storage player_motion: _.launch.q set compute default float {type:"minecraft:min",inputs:[{type:"minecraft:max",inputs:[{type:"minecraft:div",left:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.unit_horizontal"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.eye_height"}]},right:{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.distance"}},-1.0]},1.0]}
execute if score #residual PlayerMotion.X matches 1 run data modify storage player_motion: _.launch.d set compute default float {type:"minecraft:negate",input:{type:"minecraft:add",inputs:[{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.eye_height"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.unit_y"}]},{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.distance"},{type:"minecraft:sqrt",input:{type:"minecraft:max",inputs:[{type:"minecraft:sub",left:1.0,right:{type:"minecraft:mul",inputs:[{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.q"},{type:"minecraft:storage",storage:"player_motion:",path:"_.launch.q"}]}},0.0]}}]}]}}
